{% extends 'page.html.twig' %}

{%- block content %}
      <h1 class="text-2xl font-semibold sm:text-3xl">{{ page.title }}</h1>
      <div class="app-prose max-w-app mt-8">
        {{- page.content }}
        {%- for photo in site.data.photos.soltek_eq3401.sp94_guide_montage %}
        <figure>
          <a href="{{ url(photo.file) }}"><img src="{{ url(photo.file|resize(600)) }}" alt="{{ photo.description|e('html_attr') }}" /></a>
          <figcaption>{{ photo.description }}</figcaption>
        </figure>
        {%- endfor %}
      </div>
{%- endblock content %}
