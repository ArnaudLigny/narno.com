{% extends '_default/page.html.twig' %}

{%- block head %}
    {{- parent() }}
    {%- if site.webmention %}
    <link rel="pingback" href="https://webmention.io/narno.com/xmlrpc" />
    <link rel="webmention" href="https://webmention.io/narno.com/webmention" />
    {%- endif %}
    {%- if site.cloudflareinsights is defined %}
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cloudflareinsights }}"}'></script>
    {%- endif %}
{%- endblock head %}
