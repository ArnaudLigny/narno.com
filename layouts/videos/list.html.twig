{% extends '_default/list.html.twig' %}

{%- block content %}
      <h1 class="text-2xl font-semibold sm:text-3xl">{{ page.title }}</h1>
      {%- if page.description|default %}
      <p class="mt-2 mb-6 italic">{{ page.description }}</p>
      {%- endif %}
      {%- for page_video in pages|sort_by_date %}
      <article class="my-10">
        <a href="{{ url(page_video) }}" class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline">
          <h2>{{ page_video.title }}</h2>
        </a>
        {{ include('partials/paper/datetime.html.twig', {post: page_video}, with_context = false) }}
        <div class="mt-4">
          {{- include('partials/player.html.twig', {page: page_video}, with_context = false) }}
        </div>
      </article>
      {%- endfor %}
{%- endblock content %}
