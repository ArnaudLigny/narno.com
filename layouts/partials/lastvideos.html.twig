{#- Partial to display the last videos ~#}
{%- set videos_section = site.page('videos') %}
<section id="last-videos" class="app-layout">
<div class="border-border border-t pt-12 pb-6">
  <style>{% apply minify_css %}
    #last-videos .videos { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 1.5rem; }
    #last-videos .video:nth-child(n+3) { display: none; }
    @media (min-width: 640px) {
      #last-videos .videos { grid-template-columns: repeat(3, 1fr); }
      #last-videos .video:nth-child(3) { display: block; }
    }
    #last-videos .video { position: relative; display: block; border-radius: .5rem; overflow: hidden; }
    #last-videos .video img { display: block; width: 100%; height: auto; transition: transform .2s; }
    #last-videos .video:hover img { transform: scale(1.03); }
    #last-videos .play-btn { position: absolute; inset: 0; z-index: 1; display: flex; align-items: center; justify-content: center; color: #fff; }
    #last-videos .play-btn svg { width: 3rem; height: 3rem; filter: drop-shadow(0 0 .4rem rgba(0,0,0,.6)); }
  {% endapply %}</style>
  <h2 class="text-2xl font-semibold tracking-wide">Dernières vidéos</h2>
  <div class="videos">
    {%- for page_video in site.pages.showable|filter_by('section', 'videos')|sort_by_date|slice(0, 3) %}
    <a href="{{ url(page_video) }}" class="video" title="{{ page_video.title|e('html_attr') }}">
      <div class="play-btn">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd" /></svg>
      </div>
      {{ html(asset(page_video.image)|resize(480), {alt: page_video.title}, {responsive: false}) }}
    </a>
    {%- endfor %}
  </div>
  {%- if videos_section %}
  <div class="my-8 text-center">
    <a href="{{ url(videos_section) }}" class="hover:text-accent">Toutes les vidéos ›</a>
  </div>
  {%- endif %}
</div>
</section>
