{#- Previous (older) and next (newer) posts ~#}
{#- Override: labels of videos ~#}
{%- set is_video = page.section == 'videos' -%}
{%- import 'macros/paper.twig' as paper -%}
{%- if page.prev is defined or page.next is defined -%}
<div class="my-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
  {%- if page.prev is defined and page.prev %}
  <a href="{{ url(page.prev) }}" rel="prev" class="flex w-full gap-1 hover:opacity-75">
    {{ paper.icon('arrow-left', 'inline-block flex-none rtl:rotate-180') }}
    <div>
      <span>{{ is_video ? 'Vidéo précédente' : 'Previous Post'|trans }}</span>
      <div class="text-accent/85 text-sm">{{ page.prev.title }}</div>
    </div>
  </a>
  {%- endif %}
  {%- if page.next is defined and page.next %}
  <a href="{{ url(page.next) }}" rel="next" class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2">
    <div>
      <span>{{ is_video ? 'Vidéo suivante' : 'Next Post'|trans }}</span>
      <div class="text-accent/85 text-sm">{{ page.next.title }}</div>
    </div>
    {{ paper.icon('arrow-right', 'inline-block flex-none rtl:rotate-180') }}
  </a>
  {%- endif %}
</div>
{%- endif -%}